            "description": "Model slug."
          },
          "text": {
            "type": "string",
            "required": true
          },
          "voice": {
            "type": "string"
          },
          "callback_url": {
            "type": "string"
          },
          "stability": {
            "type": "number"
          },
          "similarity_boost": {
            "type": "number"
          },
          "style": {
            "type": "number"
          },
          "speed": {
            "type": "number"
          },
          "timestamps": {
            "type": "boolean"
          },
          "previous_text": {
            "type": "string"
          },
          "next_text": {
            "type": "string"
          },
          "language_code": {
            "type": "string"
          }
        },
        "text-to-speech-turbo-v2.5": {
          "model": {
