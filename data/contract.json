      "model": "ElevenLabs",
      "endpoint": "text_to_speech",
      "task_type": "asynchronous",
      "models": [
        "text-to-speech-multilingual-v2",
        "text-to-speech-turbo-v2.5"
      ],
      "rules": [
        {
          "when": {
            "model": "text-to-speech-multilingual-v2"
          },
          "required": [
            "voice"
          ]
        }
      ],
      "fields_by_model": {
        "text-to-speech-multilingual-v2": {
          "model": {
