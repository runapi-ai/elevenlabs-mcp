          },
          "speed": {
            "type": "number"
          },
          "timestamps": {
            "type": "boolean"
          },
          "previous_text": {
            "type": "string"
          },
          "next_text": {
            "type": "string"
          },
          "language_code": {
            "type": "string"
          }
        }
